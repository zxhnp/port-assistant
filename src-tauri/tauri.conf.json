{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "端口助手",
  "mainBinaryName": "port-assistant",
  "version": "0.1.1",
  "identifier": "com.portassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "端口助手",
        "decorations": false,
        "width": 1400,
        "height": 930,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": { "languages": ["SimpChinese"], "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico", "template": "installer/installer.nsi" },
      "wix": { "language": "zh-CN", "template": "installer/main.wxs" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
